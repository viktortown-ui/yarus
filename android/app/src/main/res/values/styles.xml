<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#153F3B</item>
        <item name="android:navigationBarColor">#153F3B</item>
        <item name="android:colorAccent">#246B5A</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ScannerTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#07110F</item>
        <item name="android:navigationBarColor">#07110F</item>
        <item name="android:colorAccent">#63CDA9</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
