# Release secrets are never committed. tools/build_android_release.ps1 loads
# equivalent YARUS_KEYSTORE_* environment variables from the private key folder.
YARUS_KEYSTORE_FILE=C:\\private\\YARUS-release.jks
YARUS_KEYSTORE_PASSWORD=replace-me
YARUS_KEY_ALIAS=yarus-release
YARUS_KEY_PASSWORD=replace-me
